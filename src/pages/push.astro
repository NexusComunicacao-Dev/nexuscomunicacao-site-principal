---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Drawer from '../components/Drawer.astro';
import Footer from '../components/Footer.astro';
import Logo from '../components/Logo.astro';
import WhatsAppFab from '../components/WhatsAppFab.astro';
---
<Base title="NEXUS — Push Ads · Marketing de Proximidade">
<style is:inline slot="head">
@import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap');

:root {
  --orange: #ff7c1a; --orange-d: #e06010; --orange-l: #ff9a4a;
  --dark: #4a4a4a; --dark2: #3d3d3d; --dark3: #565656;
  --light: #f7f7f7; --light2: #ffffff;
  --cw: 1200px; --px: 24px; --py: 80px;
}

*, *::before, *::after { margin:0; padding:0; box-sizing:border-box; }
html { scroll-behavior:smooth; -webkit-tap-highlight-color:transparent; }
body { font-family:'Inter',sans-serif; background:var(--dark); color:#fff; overflow-x:hidden; }
::-webkit-scrollbar { width:4px; }
::-webkit-scrollbar-thumb { background:var(--orange); border-radius:2px; }
img, svg { display:block; max-width:100%; }
a { text-decoration:none; }

.channel-layout, .o2o-inner, .lf-inner, .footer-grid, .footer-bottom {
  max-width:var(--cw); margin-left:auto; margin-right:auto; width:100%;
}

.btn-primary { display:inline-flex; align-items:center; gap:8px; padding:14px 28px; background:var(--orange); color:#fff; border:none; border-radius:10px; font-size:15px; font-weight:700; cursor:pointer; font-family:inherit; box-shadow:0 6px 24px rgba(255,124,26,.4); transition:all .22s; }
.btn-primary:hover { background:var(--orange-l); transform:translateY(-2px); box-shadow:0 10px 36px rgba(255,124,26,.55); }
.btn-ghost { display:inline-flex; align-items:center; gap:8px; padding:14px 28px; background:transparent; color:#fff; border:1.5px solid rgba(255,255,255,.22); border-radius:10px; font-size:15px; font-weight:600; cursor:pointer; font-family:inherit; transition:all .22s; }
.btn-ghost:hover { border-color:var(--orange); color:var(--orange); background:rgba(255,124,26,.05); }
.tag { display:inline-block; padding:5px 14px; background:rgba(255,124,26,.1); border:1px solid rgba(255,124,26,.28); border-radius:100px; font-size:11px; font-weight:700; letter-spacing:.1em; text-transform:uppercase; color:var(--orange); margin-bottom:18px; }
.tag.dark { background:rgba(255,124,26,.12); }
.h2 { font-size:clamp(28px,4vw,50px); font-weight:900; letter-spacing:-.03em; line-height:1.08; }
.sub { font-size:clamp(15px,1.8vw,17px); color:rgba(255,255,255,.5); line-height:1.8; margin-top:16px; max-width:520px; }
.sub.light-text { color:#666; }

.rv { opacity:0; transform:translateY(28px); transition:opacity .7s ease,transform .7s ease; }
.rv.on { opacity:1; transform:none; }
.rv1 { transition-delay:.1s; } .rv2 { transition-delay:.2s; }
.rv3 { transition-delay:.3s; } .rv4 { transition-delay:.4s; }

/* NAV */
nav { position:fixed; top:0; left:0; right:0; z-index:1000; display:flex; align-items:center; justify-content:space-between; padding:16px 20px; background:rgba(45,45,45,.92); backdrop-filter:blur(18px); border-bottom:1px solid rgba(255,124,26,.1); transition:all .3s; }
nav.scrolled { padding:10px 20px; background:rgba(45,45,45,.99); }
.nav-logo svg { height:30px; }
.nav-links { display:none; align-items:center; gap:28px; }
.nav-links a { color:rgba(255,255,255,.72); font-size:14px; font-weight:500; transition:color .2s; }
.nav-links a:hover { color:var(--orange); }
.btn-nav { padding:9px 18px; background:var(--orange); color:#fff; border:none; border-radius:8px; font-size:13px; font-weight:600; cursor:pointer; font-family:inherit; box-shadow:0 4px 18px rgba(255,124,26,.35); transition:all .2s; white-space:nowrap; }
.btn-nav:hover { background:var(--orange-l); transform:translateY(-1px); }
.nav-switch { display:inline-flex; align-items:center; gap:6px; padding:7px 14px; border:1px solid rgba(255,255,255,.2); border-radius:20px; color:rgba(255,255,255,.65); font-size:12px; font-weight:600; transition:all .2s; letter-spacing:.02em; white-space:nowrap; }
.nav-switch:hover { border-color:var(--orange); color:var(--orange); background:rgba(255,124,26,.08); }
.nav-switch svg { width:12px; height:12px; fill:currentColor; }

/* HAMBURGER */
.nav-ham { display:flex; flex-direction:column; justify-content:center; gap:5px; width:40px; height:40px; padding:6px; background:transparent; border:none; cursor:pointer; z-index:1002; flex-shrink:0; }
.nav-ham span { display:block; width:22px; height:2px; background:rgba(255,255,255,.85); border-radius:2px; transition:all .28s cubic-bezier(.22,1,.36,1); transform-origin:center; }
.nav-ham.open span:nth-child(1) { transform:rotate(45deg) translate(5px,5px); }
.nav-ham.open span:nth-child(2) { opacity:0; width:0; }
.nav-ham.open span:nth-child(3) { transform:rotate(-45deg) translate(5px,-5px); }
.nav-drawer { position:fixed; top:0; left:0; right:0; bottom:0; z-index:1001; background:rgba(42,42,42,.98); backdrop-filter:blur(20px); display:flex; flex-direction:column; align-items:flex-start; padding:84px 32px 48px; gap:0; transform:translateX(100%); transition:transform .35s cubic-bezier(.22,1,.36,1); pointer-events:none; overflow-y:auto; }
.nav-drawer.open { transform:none; pointer-events:auto; }
.nav-drawer a { display:block; color:rgba(255,255,255,.78); font-size:20px; font-weight:700; padding:16px 0; width:100%; border-bottom:1px solid rgba(255,255,255,.08); transition:color .2s; }
.nav-drawer a:last-of-type { border-bottom:none; }
.nav-drawer a:hover { color:var(--orange); }
.drawer-cta { margin-top:28px !important; width:100%; font-size:16px !important; padding:16px !important; text-align:center; justify-content:center; border-radius:12px !important; border:none !important; cursor:pointer; font-family:inherit !important; }

/* iPHONE */
.iphone-wrap { display:flex; justify-content:center; align-items:center; perspective:1100px; padding:40px 20px; }
.iphone { position:relative; width:240px; height:500px; transform-style:preserve-3d; transition:transform .08s ease-out; cursor:grab; flex-shrink:0; }
.iphone-frame { position:absolute; inset:0; border-radius:46px; background:linear-gradient(158deg,#484848 0%,#363636 25%,#1e1e1e 55%,#363636 80%,#484848 100%); box-shadow:inset 0 0 0 1px rgba(255,255,255,.22),inset 0 0 0 2.5px rgba(0,0,0,.75),0 40px 90px rgba(0,0,0,.85),0 16px 40px rgba(0,0,0,.55),0 0 50px rgba(255,124,26,.07); }
.iphone-frame::after { content:''; position:absolute; top:0; left:12%; right:12%; height:1px; background:rgba(255,255,255,.3); border-radius:100%; }
.iphone-screen { position:absolute; top:9px; left:9px; right:9px; bottom:9px; border-radius:38px; background:#050508; overflow:hidden; box-shadow:inset 0 0 0 .5px rgba(255,255,255,.07); }
.iphone-screen::before { content:''; position:absolute; inset:0; z-index:100; pointer-events:none; border-radius:38px; background:linear-gradient(130deg,rgba(255,255,255,.07) 0%,rgba(255,255,255,.02) 35%,transparent 65%); }
.di { position:absolute; top:11px; left:50%; transform:translateX(-50%); width:96px; height:27px; background:#000; border-radius:18px; z-index:50; display:flex; align-items:center; justify-content:flex-end; padding-right:10px; }
.di-dot { width:9px; height:9px; border-radius:50%; background:#1a1a22; border:1px solid rgba(255,255,255,.1); }
.hw-action { position:absolute; left:-3px; top:86px; width:3px; height:20px; border-radius:3px 0 0 3px; background:linear-gradient(to right,#222,#3a3a3a); }
.hw-vol-up { position:absolute; left:-3px; top:120px; width:3px; height:40px; border-radius:3px 0 0 3px; background:linear-gradient(to right,#222,#3a3a3a); }
.hw-vol-down { position:absolute; left:-3px; top:170px; width:3px; height:40px; border-radius:3px 0 0 3px; background:linear-gradient(to right,#222,#3a3a3a); }
.hw-power { position:absolute; right:-3px; top:135px; width:3px; height:56px; border-radius:0 3px 3px 0; background:linear-gradient(to left,#222,#3a3a3a); }
.screen-inner { position:absolute; inset:0; overflow:hidden; display:flex; flex-direction:column; }
.status-bar { display:flex; justify-content:space-between; align-items:center; padding:46px 18px 0; font-size:11px; font-weight:700; color:#fff; flex-shrink:0; }
.status-icons { display:flex; align-items:center; gap:4px; }

/* PUSH NOTIFICATION CARDS */
@keyframes pushSlideIn { from{opacity:0;transform:translateY(-10px)} to{opacity:1;transform:none} }
.push-card { margin:8px 10px 0; background:rgba(255,255,255,.14); backdrop-filter:blur(12px); border-radius:14px; padding:10px 12px; border:1px solid rgba(255,255,255,.15); animation:pushSlideIn .4s ease both; }
.push-card+.push-card { margin-top:6px; animation-delay:.35s; }
.push-app-row { display:flex; align-items:center; gap:6px; margin-bottom:5px; }
.push-app-icon { width:18px; height:18px; border-radius:5px; background:var(--orange); display:flex; align-items:center; justify-content:center; font-size:8px; font-weight:900; color:#fff; flex-shrink:0; }
.push-app-name { font-size:10px; color:rgba(255,255,255,.6); font-weight:600; }
.push-app-time { font-size:9px; color:rgba(255,255,255,.4); margin-left:auto; }
.push-title { font-size:11.5px; font-weight:700; color:#fff; line-height:1.3; }
.push-body { font-size:10px; color:rgba(255,255,255,.72); line-height:1.4; margin-top:3px; }
.push-badge { display:inline-block; padding:2px 8px; background:var(--orange); border-radius:20px; font-size:8.5px; font-weight:700; color:#fff; margin-top:5px; }
@keyframes lsPulse { 0%{transform:scale(.8);opacity:1} 100%{transform:scale(2);opacity:0} }
.ls-pin { display:inline-flex; align-items:center; justify-content:center; width:24px; height:24px; position:relative; }
.ls-pin-ring { position:absolute; inset:0; border:1.5px solid rgba(255,124,26,.55); border-radius:50%; animation:lsPulse 2s ease-in-out infinite; }
.ls-pin-ring2 { animation-delay:.7s; }
.ls-pin-dot { width:7px; height:7px; border-radius:50%; background:var(--orange); }

/* HERO */
#hero { min-height:100svh; display:flex; flex-direction:column; padding:90px var(--px) 60px; position:relative; overflow:hidden; align-items:center; gap:40px; }
.hero-glow { position:absolute; inset:0; pointer-events:none; background:radial-gradient(ellipse 90% 60% at 50% 30%,rgba(255,124,26,.07) 0%,transparent 60%),radial-gradient(ellipse 60% 40% at 80% 70%,rgba(255,124,26,.04) 0%,transparent 50%); }
.hero-grid-bg { position:absolute; inset:0; pointer-events:none; background-image:linear-gradient(rgba(255,124,26,.04) 1px,transparent 1px),linear-gradient(90deg,rgba(255,124,26,.04) 1px,transparent 1px); background-size:56px 56px; mask-image:radial-gradient(ellipse at 50% 30%,black 20%,transparent 75%); }
.hero-text { position:relative; z-index:2; text-align:center; max-width:600px; }
.hero-badge { display:inline-flex; align-items:center; gap:8px; padding:6px 14px; border-radius:100px; margin-bottom:22px; background:rgba(255,124,26,.12); border:1px solid rgba(255,124,26,.3); font-size:12px; font-weight:700; color:var(--orange); letter-spacing:.08em; text-transform:uppercase; }
.hero-badge-dot { width:6px; height:6px; border-radius:50%; background:var(--orange); animation:pulseDot 1.6s ease-in-out infinite; }
@keyframes pulseDot { 0%,100%{opacity:1;transform:scale(1)} 50%{opacity:.4;transform:scale(1.5)} }
.hero-title { font-size:clamp(42px,9vw,80px); font-weight:900; letter-spacing:-.04em; line-height:.98; margin-bottom:20px; }
.hero-title .accent { color:var(--orange); }
.hero-sub-txt { font-size:clamp(15px,2vw,18px); color:rgba(255,255,255,.5); line-height:1.75; margin-bottom:32px; }
.hero-ctas { display:flex; gap:12px; flex-wrap:wrap; justify-content:center; margin-bottom:40px; }
.hero-pills { display:grid; grid-template-columns:1fr 1fr; gap:10px; text-align:left; }
.pill { display:flex; align-items:flex-start; gap:10px; padding:12px 14px; background:rgba(255,255,255,.04); border:1px solid rgba(255,255,255,.08); border-radius:12px; }
.pill-icon { font-size:18px; flex-shrink:0; margin-top:1px; }
.pill-text { font-size:12px; line-height:1.5; }
.pill-text strong { display:block; color:#fff; font-size:13px; font-weight:700; }
.pill-text span { color:rgba(255,255,255,.45); }
.hero-phone-zone { position:relative; z-index:2; display:flex; justify-content:center; width:100%; }
#heroPhone { width:240px; height:500px; }

/* STATS BAR */
.stats-bar { background:var(--dark2); border-top:1px solid rgba(255,255,255,.06); border-bottom:1px solid rgba(255,255,255,.06); padding:24px var(--px); display:grid; grid-template-columns:repeat(2,1fr); gap:20px 12px; }
.stat-item { text-align:center; }
.stat-num { font-size:24px; font-weight:900; color:var(--orange); display:block; }
.stat-lbl { font-size:11px; color:rgba(255,255,255,.42); margin-top:3px; line-height:1.3; }

/* SECTION */
section { padding:var(--py) var(--px); }
.sec-light { background:var(--light); color:#111; }
.sec-light .sub { color:#666; }
.sec-light .tag { background:rgba(255,124,26,.1); border-color:rgba(255,124,26,.28); }

/* CHANNEL */
.channel-layout { display:flex; flex-direction:column; gap:32px; align-items:center; }
.channel-text { width:100%; }
/* Phone first on mobile so it's visible when tapping tabs */
.channel-phone-zone { display:flex; justify-content:center; width:100%; order:-1; }
.ch-tabs { margin-top:32px; display:flex; flex-direction:column; gap:6px; }
.tab { display:flex; align-items:center; gap:14px; padding:12px 16px; border-radius:10px; cursor:pointer; border:1px solid transparent; transition:all .22s; }
.tab:hover { background:rgba(255,124,26,.06); border-color:rgba(255,124,26,.18); }
.tab.active { background:rgba(255,124,26,.09); border-color:rgba(255,124,26,.32); }
.tab-n { width:30px; height:30px; border-radius:8px; flex-shrink:0; background:rgba(0,0,0,.08); display:flex; align-items:center; justify-content:center; font-size:11px; font-weight:700; color:#999; transition:all .22s; }
.tab.active .tab-n { background:var(--orange); color:#fff; }
.tab-body { display:flex; flex-direction:column; gap:2px; }
.tab-l { font-size:14px; font-weight:600; color:#555; transition:all .22s; }
.tab.active .tab-l { color:#111; }
.tab-desc { font-size:11.5px; color:#999; line-height:1.4; display:none; }
.tab.active .tab-desc { display:block; color:var(--orange); font-weight:500; }
.tab-cta { margin-top:28px; }
#chPhone { width:220px; height:464px; }
.ch-push-wrap { padding:52px 10px 0; position:relative; min-height:90px; }
@keyframes chCardIn { from{opacity:0;transform:translateY(5px)} to{opacity:1;transform:none} }
.ch-push-card { background:rgba(255,255,255,.11); border-radius:12px; padding:8px 10px; border:1px solid rgba(255,255,255,.1); display:none; }
.ch-push-card.ch-active { display:block; animation:chCardIn .3s ease forwards; }
.ch-push-hdr { display:flex; align-items:center; gap:5px; margin-bottom:3px; }
.ch-push-ico { width:14px; height:14px; border-radius:4px; background:var(--orange); display:flex; align-items:center; justify-content:center; font-size:6px; font-weight:900; color:#fff; }
.ch-push-app { font-size:8.5px; color:rgba(255,255,255,.55); font-weight:600; }
.ch-push-title { font-size:10px; font-weight:700; color:#fff; }
.ch-push-body { font-size:8.5px; color:rgba(255,255,255,.6); margin-top:2px; line-height:1.35; }
.ch-loc { display:flex; align-items:center; gap:4px; margin-top:4px; }
.ch-loc-txt { font-size:8px; color:rgba(255,124,26,.9); font-weight:600; }

/* FORMATOS */
#formatos { background:var(--dark2); }
.fmt-grid { display:grid; grid-template-columns:1fr; gap:20px; margin-top:40px; }
.fmt-card { background:rgba(255,255,255,.04); border:1px solid rgba(255,255,255,.08); border-radius:20px; padding:28px 24px; transition:all .3s; }
.fmt-card:hover { border-color:rgba(255,124,26,.35); background:rgba(255,124,26,.04); }
.fmt-icon { width:52px; height:52px; border-radius:14px; background:rgba(255,124,26,.12); display:flex; align-items:center; justify-content:center; margin-bottom:18px; }
.fmt-icon svg { width:26px; height:26px; }
.fmt-name { font-size:20px; font-weight:800; color:#fff; margin-bottom:10px; }
.fmt-desc { font-size:14px; color:rgba(255,255,255,.55); line-height:1.65; }
.fmt-badge { display:inline-block; margin-top:14px; padding:4px 12px; background:rgba(255,124,26,.12); border:1px solid rgba(255,124,26,.25); border-radius:100px; font-size:11px; color:var(--orange); font-weight:700; }

/* O2O */
#o2o { background:var(--dark3); }
.o2o-inner { display:flex; flex-direction:column; gap:24px; }
.o2o-card { background:rgba(255,255,255,.04); border:1px solid rgba(255,255,255,.09); border-radius:20px; padding:28px 24px; }
.o2o-eyebrow { font-size:10px; font-weight:700; letter-spacing:.15em; text-transform:uppercase; color:var(--orange); margin-bottom:8px; }
.o2o-title { font-size:22px; font-weight:800; color:#fff; margin-bottom:12px; line-height:1.2; }
.o2o-desc { font-size:14px; color:rgba(255,255,255,.55); line-height:1.65; }
.o2o-metrics { display:grid; grid-template-columns:1fr 1fr; gap:12px; margin-top:20px; }
.o2o-metric { background:rgba(255,255,255,.05); border-radius:12px; padding:14px; text-align:center; }
.o2o-metric-val { font-size:26px; font-weight:900; color:var(--orange); display:block; }
.o2o-metric-lbl { font-size:10px; color:rgba(255,255,255,.4); margin-top:3px; }

/* TARGET */
#target { background:var(--light); }
.target-grid { display:grid; grid-template-columns:repeat(2,1fr); gap:12px; margin-top:36px; }
.target-item { display:flex; align-items:center; gap:12px; padding:14px 16px; background:#fff; border-radius:12px; border:1px solid rgba(0,0,0,.06); box-shadow:0 2px 8px rgba(0,0,0,.04); transition:all .22s; }
.target-item:hover { border-color:var(--orange); box-shadow:0 4px 16px rgba(255,124,26,.12); }
.target-icon { width:36px; height:36px; border-radius:10px; background:rgba(255,124,26,.1); display:flex; align-items:center; justify-content:center; flex-shrink:0; font-size:17px; }
.target-name { font-size:13px; font-weight:600; color:#333; line-height:1.3; }

/* DEPOIMENTOS */
#depoimentos { background:#444; padding:var(--py) var(--px); text-align:center; position:relative; overflow:hidden; }
.dep-inner { max-width:820px; margin:0 auto; position:relative; z-index:1; }
.dep-tag-lbl { font-size:11px; font-weight:700; letter-spacing:.18em; color:var(--orange); text-transform:uppercase; margin-bottom:36px; }
.dep-quote-mark { font-size:88px; line-height:.9; color:rgba(255,255,255,.13); font-family:Georgia,serif; margin-bottom:20px; font-weight:900; }
.dep-slides { display:grid; grid-template-columns:1fr; grid-template-rows:1fr; min-height:160px; }
.dep-slide { grid-area:1/1; opacity:0; pointer-events:none; transform:translateY(10px); transition:opacity .55s,transform .55s; }
.dep-slide.dep-active { opacity:1; pointer-events:auto; transform:none; }
.dep-text { font-size:clamp(15px,2vw,18px); color:rgba(255,255,255,.88); line-height:1.72; font-style:italic; }
.dep-name { font-size:15px; font-weight:700; color:#fff; margin-bottom:5px; }
.dep-role { font-size:13px; color:rgba(255,255,255,.48); }
.dep-avatars { display:flex; gap:14px; justify-content:center; margin-top:40px; flex-wrap:wrap; }
.dep-av-btn { width:56px; height:56px; border-radius:50%; border:2.5px solid transparent; background:transparent; cursor:pointer; padding:3px; transition:all .3s; display:flex; align-items:center; justify-content:center; }
.dep-av-btn.dep-active { border-color:var(--orange); }
.dep-av { width:100%; height:100%; border-radius:50%; display:flex; align-items:center; justify-content:center; font-size:14px; font-weight:700; color:#fff; }
.dep-av-btn:not(.dep-active) .dep-av { background:rgba(255,255,255,.16); filter:grayscale(1); }
.dep-av-btn.dep-active .dep-av { background:var(--orange); filter:none; }

/* LEAD FORM */
#lead-form { background:var(--light); position:relative; overflow:hidden; }
.lf-glow { position:absolute; inset:0; pointer-events:none; background:radial-gradient(ellipse 70% 60% at 70% 50%,rgba(255,124,26,.07) 0%,transparent 60%); }
.lf-inner { display:flex; flex-direction:column; gap:40px; position:relative; z-index:1; }
.lf-copy { max-width:480px; }
.lf-trust { display:flex; flex-wrap:wrap; gap:8px; margin-top:24px; }
.trust-it { padding:6px 14px; background:#fff; border:1px solid rgba(0,0,0,.09); border-radius:100px; font-size:12px; font-weight:600; color:#555; }
.trust-it::before { content:'✓ '; color:var(--orange); font-weight:900; }
.lf-card { background:#fff; border-radius:20px; padding:36px 28px; box-shadow:0 12px 40px rgba(0,0,0,.1); border-top:3px solid var(--orange); }
.lf-card h3 { font-size:22px; font-weight:800; color:#111; margin-bottom:6px; }
.lf-card p { font-size:14px; color:#888; margin-bottom:28px; }
.frow { display:grid; grid-template-columns:1fr; gap:14px; }
.fg { display:flex; flex-direction:column; gap:8px; margin-bottom:20px; }
.fg label { font-size:11.5px; font-weight:700; color:#555; letter-spacing:.05em; text-transform:uppercase; }
.fi { width:100%; padding:14px 16px; border:1.5px solid rgba(0,0,0,.12); border-radius:10px; font-size:14.5px; color:#111; font-family:inherit; background:#fafafa; transition:all .2s; outline:none; }
