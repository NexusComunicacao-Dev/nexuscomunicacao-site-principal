<script is:inline>
/* DRAWER */
function toggleDrawer(){const d=document.getElementById('navDrawer'),h=document.getElementById('navHam'),open=d.classList.toggle('open');h.classList.toggle('open',open);document.body.style.overflow=open?'hidden':'';}
function closeDrawer(){document.getElementById('navDrawer').classList.remove('open');document.getElementById('navHam').classList.remove('open');document.body.style.overflow='';}
window.addEventListener('resize',()=>{if(window.innerWidth>=640)closeDrawer();});

/* NAV SCROLL */
const nav=document.getElementById('nav');
addEventListener('scroll',()=>nav.classList.toggle('scrolled',scrollY>40));

/* 3D TILT */
(function(){
  const wrap=document.querySelector('.iphone-wrap');
  const phone=document.getElementById('heroPhone');
  if(!wrap||!phone)return;
  phone.style.transform='rotateX(2deg) rotateY(-4deg)';
  wrap.addEventListener('mousemove',e=>{const r=wrap.getBoundingClientRect(),x=(e.clientX-r.left)/r.width-.5,y=(e.clientY-r.top)/r.height-.5;phone.style.transform=`rotateX(${-y*14}deg) rotateY(${x*20}deg)`;});
  wrap.addEventListener('mouseleave',()=>{phone.style.transform='rotateX(2deg) rotateY(-4deg)';});
})();

/* CHANNEL TABS */
function switchTab(el,idx){
  document.querySelectorAll('#chTabs .tab').forEach(t=>t.classList.remove('active'));
  el.classList.add('active');
  for(let i=0;i<5;i++){
    const c=document.getElementById('chCard'+i);
    if(!c)continue;
    if(i===idx){c.classList.add('ch-active');}
    else{c.classList.remove('ch-active');}
  }
}

/* COUNT UP */
function countUp(el){
  const raw=el.textContent.replace(/[^0-9.]/g,''),suf=el.textContent.replace(/[0-9.]/g,''),target=parseFloat(raw);
  if(!target)return;
  const dur=1600,start=performance.now();
  function step(now){const t=Math.min((now-start)/dur,1),ease=1-Math.pow(1-t,3),val=target*ease;el.textContent=(target%1===0?Math.round(val):val.toFixed(1))+suf;if(t<1)requestAnimationFrame(step);}
  requestAnimationFrame(step);
}
const so=new IntersectionObserver(entries=>{entries.forEach(e=>{if(e.isIntersecting){e.target.querySelectorAll('.stat-num').forEach(countUp);so.unobserve(e.target);}});},{threshold:.5});
const sb=document.querySelector('.stats-bar');if(sb)so.observe(sb);

/* SCROLL REVEAL */
const ro=new IntersectionObserver(entries=>{entries.forEach(e=>{if(e.isIntersecting)e.target.classList.add('on');});},{threshold:.12});
document.querySelectorAll('.rv').forEach(el=>ro.observe(el));

/* MESH */
(function(){
  const COLS=20,ROWS=11,AMP=16,SPD=0.01;let gT=0,sOff=0;const layers=[];
  window.addEventListener('scroll',()=>{sOff=scrollY*.00014;},{passive:true});
  function draw(cvs,ctx){const W=cvs.width,H=cvs.height;if(W<2||H<2)return;ctx.clearRect(0,0,W,H);const sx=W/(COLS-1),sy=H/(ROWS-1),T=gT+sOff,g=[];for(let r=0;r<ROWS;r++){g[r]=[];for(let c=0;c<COLS;c++)g[r][c]={x:c*sx+Math.sin(c*.52+r*.38+T)*AMP,y:r*sy+Math.cos(c*.38+r*.52+T*.88)*AMP};}ctx.beginPath();ctx.strokeStyle='rgba(255,255,255,0.04)';ctx.lineWidth=.65;for(let r=0;r<ROWS;r++)for(let c=0;c<COLS;c++){if(c<COLS-1){ctx.moveTo(g[r][c].x,g[r][c].y);ctx.lineTo(g[r][c+1].x,g[r][c+1].y);}if(r<ROWS-1){ctx.moveTo(g[r][c].x,g[r][c].y);ctx.lineTo(g[r+1][c].x,g[r+1][c].y);}}ctx.stroke();ctx.fillStyle='rgba(255,255,255,0.11)';for(let r=0;r<ROWS;r++)for(let c=0;c<COLS;c++){ctx.beginPath();ctx.arc(g[r][c].x,g[r][c].y,1.2,0,Math.PI*2);ctx.fill();}}
  function loop(){if(!document.hidden){for(const{cvs,ctx}of layers)draw(cvs,ctx);gT+=SPD;}requestAnimationFrame(loop);}
  function resize(){for(const{cvs}of layers){cvs.width=window.innerWidth;cvs.height=window.innerHeight;}}
  const cvs=document.getElementById('mesh');if(cvs){const ctx=cvs.getContext('2d');layers.push({cvs,ctx});resize();}
  window.addEventListener('resize',resize,{passive:true});loop();
})();
</script>

