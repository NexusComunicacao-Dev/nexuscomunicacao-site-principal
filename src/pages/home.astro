}
.footer-bottom p { font-size:11px; color:rgba(255,255,255,.22); }

/* ─── MESH CANVAS ─── */
.mesh-cvs { position:absolute; inset:0; width:100% !important; height:100% !important; z-index:0; pointer-events:none; }
#hero, #sobre, footer { position:relative; overflow:hidden; }
#hero > *:not(.mesh-cvs) { position:relative; z-index:1; }
