#sobre > *:not(.mesh-cvs) { position:relative; z-index:1; }
footer > *:not(.mesh-cvs) { position:relative; z-index:1; }

/* ─── FAB ─── */
.fab {
  position:fixed; bottom:24px; right:20px; z-index:999;
  width:52px; height:52px; background:#25D366; border-radius:50%;
  display:flex; align-items:center; justify-content:center;
  box-shadow:0 6px 22px rgba(37,211,102,.4); transition:all .3s;
}
.fab:hover { transform:scale(1.1); box-shadow:0 10px 32px rgba(37,211,102,.6); }
.fab svg { width:26px; height:26px; fill:#fff; }

