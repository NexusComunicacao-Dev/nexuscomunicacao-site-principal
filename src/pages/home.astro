<script is:inline>
/* ── DRAWER ── */
function toggleDrawer(){
  const d=document.getElementById('navDrawer'),h=document.getElementById('navHam');
  const open=d.classList.toggle('open');
  h.classList.toggle('open',open);
  document.body.style.overflow=open?'hidden':'';
}
function closeDrawer(){
  document.getElementById('navDrawer').classList.remove('open');
  document.getElementById('navHam').classList.remove('open');
  document.body.style.overflow='';
}
window.addEventListener('resize',()=>{if(window.innerWidth>=640)closeDrawer();});

/* ── NAV SCROLL ── */
const nav=document.getElementById('nav');
addEventListener('scroll',()=>nav.classList.toggle('scrolled',scrollY>40));

/* ── 3D TILT ── */
(function(){
  const wrap=document.getElementById('heroWrap');
  const phone=document.getElementById('heroPhone');
  if(!wrap||!phone)return;
  phone.style.transform='rotateX(4deg) rotateY(-6deg)';
  wrap.addEventListener('mousemove',e=>{
    const r=wrap.getBoundingClientRect();
    const dx=(e.clientX-r.left-r.width/2)/(r.width/2);
    const dy=(e.clientY-r.top-r.height/2)/(r.height/2);
    phone.style.transition='transform .06s ease-out';
    phone.style.transform=`rotateX(${-dy*16}deg) rotateY(${dx*22}deg)`;
  });
  wrap.addEventListener('mouseleave',()=>{
    phone.style.transition='transform .9s cubic-bezier(.23,1,.32,1)';
    phone.style.transform='rotateX(4deg) rotateY(-6deg)';
  });
})();

/* ── CHANNEL CYCLING ANIMATION ── */
(function(){
  const screens = ['chSMS','chRCS','chWA','chPush'];
  const labels  = ['SMS Marketing','RCS Business','WhatsApp Marketing','Marketing de Proximidade'];
  const dots    = document.querySelectorAll('.ch-dot');
  let current   = 0;
  let timer;

  function goTo(idx){
    // hide current
    document.getElementById(screens[current]).classList.remove('active');
    dots[current].classList.remove('active');
    // show next
    current = idx;
    document.getElementById(screens[current]).classList.add('active');
    dots[current].classList.add('active');
  }

  function next(){ goTo((current+1)%screens.length); }

  function startAuto(){ timer = setInterval(next, 2800); }
  function stopAuto() { clearInterval(timer); }

  startAuto();

  // dot click
  dots.forEach(dot=>{
    dot.addEventListener('click',()=>{
      stopAuto();
      goTo(parseInt(dot.dataset.ch));
      startAuto();
    });
  });
})();

/* ── SCROLL REVEAL ── */
const ro=new IntersectionObserver(entries=>{
  entries.forEach(e=>{if(e.isIntersecting)e.target.classList.add('on');});
},{threshold:0.1});
document.querySelectorAll('.rv').forEach(el=>ro.observe(el));

/* ── STAT COUNTER ── */
function countUp(el){
  const raw=el.textContent;
  const num=parseFloat(raw.replace(/[^\d.]/g,''));
  const suf=raw.replace(/[\d.]/g,'');
  if(isNaN(num))return;
  let s=null;
  const step=ts=>{
    if(!s)s=ts;
    const p=Math.min((ts-s)/1600,1);
    const ease=1-Math.pow(1-p,3);
    el.textContent=(num<10?(ease*num).toFixed(0):Math.round(ease*num))+suf;
    if(p<1)requestAnimationFrame(step);
  };
  requestAnimationFrame(step);
}
const so=new IntersectionObserver(entries=>{
  entries.forEach(e=>{
    if(e.isIntersecting){
      e.target.querySelectorAll('.stat-num,.snumber-val').forEach(countUp);
      so.unobserve(e.target);
    }
  });
},{threshold:0.5});
document.querySelectorAll('.stats-bar,.sobre-numbers').forEach(el=>so.observe(el));

/* ── MESH WAVE BACKGROUND ── */
(function(){
  const COLS=20,ROWS=11,AMP=16,SPD=0.01;
  let globalT=0,scrollOff=0;
  const layers=[];
  window.addEventListener('scroll',()=>{scrollOff=window.scrollY*0.00014;},{passive:true});

  function drawLayer(cvs,ctx){
    const W=cvs.width,H=cvs.height;
    if(W<2||H<2)return;
    ctx.clearRect(0,0,W,H);
    const sx=W/(COLS-1),sy=H/(ROWS-1),T=globalT+scrollOff;
    const g=[];
    for(let r=0;r<ROWS;r++){
      g[r]=[];
      for(let c=0;c<COLS;c++){
        g[r][c]={x:c*sx+Math.sin(c*.52+r*.38+T)*AMP,y:r*sy+Math.cos(c*.38+r*.52+T*.88)*AMP};
      }
    }
    ctx.beginPath();ctx.strokeStyle='rgba(255,255,255,0.04)';ctx.lineWidth=.65;
    for(let r=0;r<ROWS;r++)for(let c=0;c<COLS;c++){
      if(c<COLS-1){ctx.moveTo(g[r][c].x,g[r][c].y);ctx.lineTo(g[r][c+1].x,g[r][c+1].y);}
      if(r<ROWS-1){ctx.moveTo(g[r][c].x,g[r][c].y);ctx.lineTo(g[r+1][c].x,g[r+1][c].y);}
    }
    ctx.stroke();
    ctx.fillStyle='rgba(255,255,255,0.11)';
    for(let r=0;r<ROWS;r++)for(let c=0;c<COLS;c++){ctx.beginPath();ctx.arc(g[r][c].x,g[r][c].y,1.6,0,6.283);ctx.fill();}
  }

  function loop(){
    if(!document.hidden){for(const{cvs,ctx}of layers)drawLayer(cvs,ctx);globalT+=SPD;}
    requestAnimationFrame(loop);
  }

  function addLayer(section){
    const cvs=document.createElement('canvas');
    cvs.className='mesh-cvs';
    section.prepend(cvs);
    const ctx=cvs.getContext('2d');
    function resize(){cvs.width=section.offsetWidth;cvs.height=section.offsetHeight;}
    resize();
    window.addEventListener('resize',resize,{passive:true});
    layers.push({cvs,ctx});
  }

  document.querySelectorAll('#hero,#sobre,footer').forEach(addLayer);
  requestAnimationFrame(loop);
})();
</script>
