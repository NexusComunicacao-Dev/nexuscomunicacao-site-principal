---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Drawer from '../components/Drawer.astro';
import Footer from '../components/Footer.astro';
import Logo from '../components/Logo.astro';
import WhatsAppFab from '../components/WhatsAppFab.astro';
---
<Base title="NEXUS Comunicação — Plataforma de Marketing Digital">
<style is:inline slot="head">
@import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap');

/* ─── TOKENS ─── */
:root {
  --orange: #ff7c1a;
  --orange-d: #e06010;
  --orange-l: #ff9a4a;
  --dark: #4a4a4a;
  --dark2: #3d3d3d;
  --dark3: #565656;
  --light: #f7f7f7;
  --light2: #ffffff;
  --cw: 1200px;
  --px: 24px;
  --py: 80px;
}

/* ─── RESET ─── */
*, *::before, *::after { margin:0; padding:0; box-sizing:border-box; }
html { scroll-behavior:smooth; -webkit-tap-highlight-color:transparent; }
body { font-family:'Inter',sans-serif; background:var(--dark); color:#fff; overflow-x:hidden; }
::-webkit-scrollbar { width:4px; }
::-webkit-scrollbar-thumb { background:var(--orange); border-radius:2px; }
img, svg { display:block; max-width:100%; }
a { text-decoration:none; }

/* ─── CONTAINER ─── */
.wrap {
  max-width: var(--cw);
  margin-left: auto;
  margin-right: auto;
  width: 100%;
}
.footer-grid, .footer-bottom { max-width:var(--cw); margin:0 auto; width:100%; }

/* ─── UTILITIES ─── */
.btn-primary {
  display:inline-flex; align-items:center; gap:8px;
  padding:14px 28px; background:var(--orange); color:#fff;
  border:none; border-radius:10px; font-size:15px; font-weight:700;
  cursor:pointer; font-family:inherit;
  box-shadow:0 6px 24px rgba(255,124,26,.4); transition:all .22s;
}
.btn-primary:hover { background:var(--orange-l); transform:translateY(-2px); box-shadow:0 10px 36px rgba(255,124,26,.55); }

.btn-ghost {
  display:inline-flex; align-items:center; gap:8px;
  padding:14px 28px; background:transparent; color:#fff;
  border:1.5px solid rgba(255,255,255,.22); border-radius:10px;
  font-size:15px; font-weight:600; cursor:pointer; font-family:inherit;
  transition:all .22s;
}
.btn-ghost:hover { border-color:var(--orange); color:var(--orange); background:rgba(255,124,26,.05); }

.tag {
  display:inline-block; padding:5px 14px;
  background:rgba(255,124,26,.1); border:1px solid rgba(255,124,26,.28);
  border-radius:100px; font-size:11px; font-weight:700; letter-spacing:.1em;
  text-transform:uppercase; color:var(--orange); margin-bottom:18px;
}
.tag.dark { background:rgba(255,124,26,.12); }
.tag.light { background:rgba(255,124,26,.1); border-color:rgba(255,124,26,.28); }

.h2 { font-size:clamp(28px,4vw,50px); font-weight:900; letter-spacing:-.03em; line-height:1.08; }
.sub { font-size:clamp(15px,1.8vw,17px); color:rgba(255,255,255,.5); line-height:1.8; margin-top:16px; }
.sub.light-text { color:#666; }

/* reveal */
.rv { opacity:0; transform:translateY(28px); transition:opacity .7s ease,transform .7s ease; }
.rv.on { opacity:1; transform:none; }
.rv1 { transition-delay:.1s; } .rv2 { transition-delay:.2s; }
.rv3 { transition-delay:.3s; } .rv4 { transition-delay:.4s; }

/* ─── NAV ─── */
nav {
  position:fixed; top:0; left:0; right:0; z-index:1000;
  display:flex; align-items:center; justify-content:space-between;
  padding:16px 20px;
  background:rgba(45,45,45,.92); backdrop-filter:blur(18px);
  border-bottom:1px solid rgba(255,124,26,.1); transition:all .3s;
}
nav.scrolled { padding:10px 20px; background:rgba(45,45,45,.99); }
.nav-logo svg { height:30px; }
.nav-links { display:none; align-items:center; gap:28px; }
.nav-links a { color:rgba(255,255,255,.72); font-size:14px; font-weight:500; transition:color .2s; }
.nav-links a:hover { color:var(--orange); }
.btn-nav {
  padding:9px 18px; background:var(--orange); color:#fff; border:none;
  border-radius:8px; font-size:13px; font-weight:600; cursor:pointer;
  font-family:inherit; box-shadow:0 4px 18px rgba(255,124,26,.35);
  transition:all .2s; white-space:nowrap;
}
.btn-nav:hover { background:var(--orange-l); transform:translateY(-1px); }

/* hamburger */
.nav-ham {
  display:flex; flex-direction:column; justify-content:center; gap:5px;
  width:40px; height:40px; padding:6px;
  background:transparent; border:none; cursor:pointer; z-index:1002; flex-shrink:0;
}
.nav-ham span {
  display:block; width:22px; height:2px;
  background:rgba(255,255,255,.85); border-radius:2px;
  transition:all .28s cubic-bezier(.22,1,.36,1); transform-origin:center;
}
.nav-ham.open span:nth-child(1) { transform:rotate(45deg) translate(5px,5px); }
.nav-ham.open span:nth-child(2) { opacity:0; width:0; }
.nav-ham.open span:nth-child(3) { transform:rotate(-45deg) translate(5px,-5px); }

/* drawer */
.nav-drawer {
  position:fixed; top:0; left:0; right:0; bottom:0; z-index:1001;
  background:rgba(42,42,42,.98); backdrop-filter:blur(20px);
  display:flex; flex-direction:column; align-items:flex-start;
  padding:84px 32px 48px; gap:0;
  transform:translateX(100%);
  transition:transform .35s cubic-bezier(.22,1,.36,1);
  pointer-events:none; overflow-y:auto;
}
.nav-drawer.open { transform:none; pointer-events:auto; }
.nav-drawer a {
  display:block; color:rgba(255,255,255,.78); font-size:20px; font-weight:700;
  padding:16px 0; width:100%; border-bottom:1px solid rgba(255,255,255,.08); transition:color .2s;
}
.nav-drawer a:last-of-type { border-bottom:none; }
.nav-drawer a:hover { color:var(--orange); }
.drawer-cta {
  margin-top:28px !important; width:100%; font-size:16px !important;
  padding:16px !important; text-align:center; justify-content:center;
  border-radius:12px !important; border:none !important; cursor:pointer; font-family:inherit !important;
}

/* ─── iPhone FRAME ─── */
.iphone-wrap { display:flex; justify-content:center; align-items:center; perspective:1100px; padding:20px; }
.iphone {
  position:relative; width:220px; height:464px;
  transform-style:preserve-3d; transition:transform .08s ease-out; cursor:grab; flex-shrink:0;
}
.iphone-frame {
  position:absolute; inset:0; border-radius:46px;
  background:linear-gradient(158deg,#484848 0%,#363636 25%,#1e1e1e 55%,#363636 80%,#484848 100%);
  box-shadow:inset 0 0 0 1px rgba(255,255,255,.22),inset 0 0 0 2.5px rgba(0,0,0,.75),0 40px 90px rgba(0,0,0,.85),0 16px 40px rgba(0,0,0,.55),0 0 50px rgba(255,124,26,.07);
}
.iphone-frame::after {
  content:''; position:absolute; top:0; left:12%; right:12%;
  height:1px; background:rgba(255,255,255,.3); border-radius:100%;
}
.iphone-screen {
  position:absolute; top:9px; left:9px; right:9px; bottom:9px;
  border-radius:38px; background:#050508; overflow:hidden;
  box-shadow:inset 0 0 0 .5px rgba(255,255,255,.07);
}
.iphone-screen::before {
  content:''; position:absolute; inset:0; z-index:100; pointer-events:none; border-radius:38px;
  background:linear-gradient(130deg,rgba(255,255,255,.07) 0%,rgba(255,255,255,.02) 35%,transparent 65%);
}
.di {
  position:absolute; top:11px; left:50%; transform:translateX(-50%);
  width:96px; height:27px; background:#000; border-radius:18px; z-index:50;
  box-shadow:0 0 0 .5px rgba(255,255,255,.06);
  display:flex; align-items:center; justify-content:flex-end; padding-right:10px;
}
.di-dot { width:9px; height:9px; border-radius:50%; background:#1a1a22; border:1px solid rgba(255,255,255,.1); }
.hw-action  { position:absolute; left:-3px; top:86px;  width:3px; height:20px; border-radius:3px 0 0 3px; background:linear-gradient(to right,#222,#3a3a3a); }
.hw-vol-up  { position:absolute; left:-3px; top:120px; width:3px; height:40px; border-radius:3px 0 0 3px; background:linear-gradient(to right,#222,#3a3a3a); }
.hw-vol-down{ position:absolute; left:-3px; top:170px; width:3px; height:40px; border-radius:3px 0 0 3px; background:linear-gradient(to right,#222,#3a3a3a); }
.hw-power   { position:absolute; right:-3px;top:135px; width:3px; height:56px; border-radius:0 3px 3px 0; background:linear-gradient(to left,#222,#3a3a3a); }
.screen-inner { position:absolute; inset:0; overflow:hidden; display:flex; flex-direction:column; }
.status-bar {
  display:flex; justify-content:space-between; align-items:center;
  padding:46px 18px 0; font-size:11px; font-weight:700; color:#fff; flex-shrink:0;
}
.status-icons { display:flex; align-items:center; gap:4px; }

/* ─── CHANNEL SCREENS inside phone ─── */
.ch-screen {
  position:absolute; inset:0;
  opacity:0; pointer-events:none;
  transition:opacity .6s ease;
}
.ch-screen.active { opacity:1; pointer-events:auto; }

/* SMS screen */
.sms-screen { background:#050508; }
.sms-header {
  display:flex; align-items:center; gap:9px;
  padding:7px 12px; border-bottom:1px solid rgba(255,255,255,.07); margin:0; flex-shrink:0;
}
.sms-av { width:28px; height:28px; border-radius:50%; background:var(--orange); display:flex; align-items:center; justify-content:center; font-size:11px; font-weight:800; color:#fff; flex-shrink:0; }
.sms-name { font-size:11px; font-weight:700; color:#fff; }
.sms-name small { display:block; font-size:9px; color:rgba(255,255,255,.38); font-weight:400; }
.sms-body { padding:10px 12px; display:flex; flex-direction:column; gap:8px; flex:1; overflow:hidden; }
.sms-bubble {
  max-width:85%; padding:8px 11px; border-radius:14px;
  font-size:10.5px; line-height:1.55; animation:bubIn .4s ease both;
}
.sms-bubble.in { background:rgba(255,255,255,.09); color:rgba(255,255,255,.85); border-bottom-left-radius:3px; align-self:flex-start; }
.sms-bubble.out { background:var(--orange); color:#fff; border-bottom-right-radius:3px; align-self:flex-end; }
@keyframes bubIn { from{opacity:0;transform:translateY(6px)} to{opacity:1;transform:none} }

/* RCS screen */
.rcs-screen { background:#f0f0f5; }
.rcs-header { display:flex; align-items:center; gap:8px; padding:50px 12px 8px; border-bottom:1px solid rgba(0,0,0,.08); flex-shrink:0; }
.rcs-av { width:28px; height:28px; border-radius:50%; background:var(--orange); display:flex; align-items:center; justify-content:center; font-size:11px; font-weight:800; color:#fff; position:relative; flex-shrink:0; }
.rcs-av::after { content:'✓'; position:absolute; bottom:-2px; right:-2px; width:11px; height:11px; background:#4FC3F7; border-radius:50%; border:1.5px solid #f0f0f5; font-size:6px; color:#fff; font-weight:900; display:flex; align-items:center; justify-content:center; }
.rcs-name { font-size:11px; font-weight:700; color:#111; }
.rcs-name small { display:block; font-size:8.5px; color:#4FC3F7; font-weight:600; }
.rcs-body { padding:10px 10px; display:flex; flex-direction:column; gap:7px; flex:1; overflow:hidden; }
.rcs-card { background:#fff; border-radius:12px; overflow:hidden; box-shadow:0 2px 8px rgba(0,0,0,.1); }
.rcs-card-img { height:48px; background:linear-gradient(135deg,rgba(255,124,26,.5),rgba(255,80,10,.3)); display:flex; align-items:center; justify-content:center; font-size:18px; }
.rcs-card-body { padding:7px 9px; }
.rcs-card-title { font-size:9.5px; font-weight:700; color:#111; }
.rcs-card-sub { font-size:8.5px; color:#888; margin-top:1px; }
.rcs-card-btns { display:flex; gap:4px; padding:5px 9px 7px; }
.rcs-card-btn { flex:1; padding:4px; background:var(--orange); border-radius:6px; font-size:8px; font-weight:700; color:#fff; text-align:center; }

/* WhatsApp screen */
.wa-screen { background:#0b1014; }
.wa-header { display:flex; align-items:center; gap:8px; padding:50px 12px 8px; background:#1f2c34; flex-shrink:0; }
.wa-av { width:28px; height:28px; border-radius:50%; background:#25D366; display:flex; align-items:center; justify-content:center; font-size:11px; font-weight:800; color:#fff; flex-shrink:0; }
.wa-name { font-size:11px; font-weight:700; color:#fff; }
.wa-name small { display:block; font-size:8.5px; color:rgba(255,255,255,.5); }
.wa-body { padding:10px 10px; display:flex; flex-direction:column; gap:7px; flex:1; overflow:hidden; background-image:url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23ffffff' fill-opacity='0.02'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E"); }
.wa-bubble { max-width:85%; padding:7px 10px; border-radius:12px; font-size:9.5px; line-height:1.5; color:#fff; }
.wa-bubble.in { background:#1f2c34; border-bottom-left-radius:2px; align-self:flex-start; }
.wa-bubble.out { background:#005c4b; border-bottom-right-radius:2px; align-self:flex-end; }

/* Push screen */
.push-screen { background:linear-gradient(165deg,#0e1f3a 0%,#1a3a5c 40%,#0a1628 100%); }
.push-status { display:flex; justify-content:space-between; align-items:center; padding:46px 18px 8px; font-size:10px; font-weight:700; color:#fff; flex-shrink:0; }
.push-time { font-size:22px; font-weight:300; color:#fff; text-align:center; padding:0 18px 12px; }
.push-notif { margin:0 10px; background:rgba(255,255,255,.12); backdrop-filter:blur(12px); border-radius:14px; padding:10px 12px; border:1px solid rgba(255,255,255,.1); }
.push-notif-hdr { display:flex; align-items:center; gap:6px; margin-bottom:4px; }
.push-notif-ico { width:14px; height:14px; border-radius:4px; background:var(--orange); display:flex; align-items:center; justify-content:center; font-size:6px; font-weight:900; color:#fff; flex-shrink:0; }
.push-notif-app { font-size:8px; color:rgba(255,255,255,.55); font-weight:600; }
.push-notif-title { font-size:10px; font-weight:700; color:#fff; margin-bottom:2px; }
.push-notif-body { font-size:8.5px; color:rgba(255,255,255,.65); line-height:1.35; }
.push-loc { display:flex; align-items:center; gap:4px; margin-top:5px; }
.push-loc-txt { font-size:7.5px; color:rgba(255,124,26,.9); font-weight:600; }

/* channel label badge */
.ch-label {
  position:absolute; bottom:14px; left:50%; transform:translateX(-50%);
  background:rgba(255,255,255,.12); backdrop-filter:blur(8px);
  border:1px solid rgba(255,255,255,.18); border-radius:20px;
  padding:4px 12px; font-size:9px; font-weight:700; color:#fff;
  white-space:nowrap; z-index:50; letter-spacing:.06em; text-transform:uppercase;
  transition:opacity .4s;
}

/* ─── HERO ─── */
#hero {
  min-height:100svh; display:flex; flex-direction:column;
  padding:90px var(--px) 60px;
  position:relative; overflow:hidden; align-items:center; gap:40px;
}
.hero-glow {
  position:absolute; inset:0; pointer-events:none;
  background:radial-gradient(ellipse 90% 60% at 50% 30%,rgba(255,124,26,.07) 0%,transparent 60%),
             radial-gradient(ellipse 60% 40% at 80% 70%,rgba(255,124,26,.04) 0%,transparent 50%);
}
.hero-grid-bg {
  position:absolute; inset:0; pointer-events:none;
  background-image:linear-gradient(rgba(255,124,26,.04) 1px,transparent 1px),
                   linear-gradient(90deg,rgba(255,124,26,.04) 1px,transparent 1px);
  background-size:56px 56px;
  mask-image:radial-gradient(ellipse at 50% 30%, black 20%, transparent 75%);
}
.hero-text { position:relative; z-index:2; text-align:center; max-width:620px; }
.hero-badge {
  display:inline-flex; align-items:center; gap:8px;
  padding:6px 14px; border-radius:100px; margin-bottom:22px;
  background:rgba(255,124,26,.12); border:1px solid rgba(255,124,26,.3);
  font-size:12px; font-weight:700; color:var(--orange); letter-spacing:.08em; text-transform:uppercase;
}
.hero-badge-dot { width:6px; height:6px; border-radius:50%; background:var(--orange); animation:pulseDot 1.6s ease-in-out infinite; }
@keyframes pulseDot { 0%,100%{opacity:1;transform:scale(1)} 50%{opacity:.4;transform:scale(1.5)} }
.hero-title { font-size:clamp(40px,9vw,80px); font-weight:900; letter-spacing:-.04em; line-height:.98; margin-bottom:20px; }
.hero-title .accent { color:var(--orange); }
.hero-sub-txt { font-size:clamp(15px,2vw,18px); color:rgba(255,255,255,.5); line-height:1.75; margin-bottom:32px; }
.hero-ctas { display:flex; gap:12px; flex-wrap:wrap; justify-content:center; }

.hero-phone-zone {
  position:relative; z-index:2;
  display:flex; justify-content:center; align-items:center; width:100%;
}

/* channel indicator dots */
.ch-dots { display:flex; gap:6px; justify-content:center; margin-top:12px; }
.ch-dot { width:6px; height:6px; border-radius:50%; background:rgba(255,255,255,.25); transition:all .4s; cursor:pointer; }
.ch-dot.active { background:var(--orange); width:20px; border-radius:3px; }

/* ─── STATS BAR ─── */
.stats-bar {
  background:var(--dark2);
  border-top:1px solid rgba(255,255,255,.06);
  border-bottom:1px solid rgba(255,255,255,.06);
  padding:24px var(--px);
  display:grid; grid-template-columns:repeat(2,1fr); gap:20px 12px;
}
.stat-item { text-align:center; }
.stat-item:last-child { grid-column:span 2; }
.stat-num { font-size:24px; font-weight:900; color:var(--orange); display:block; }
.stat-lbl { font-size:11px; color:rgba(255,255,255,.42); margin-top:3px; line-height:1.3; }

/* ─── PRODUCTS ─── */
#produtos { background:var(--light); padding:var(--py) var(--px); }
.prod-grid { display:grid; grid-template-columns:1fr; gap:16px; margin-top:40px; }
.prod-card {
  background:#fff; border-radius:20px; padding:28px 24px;
  border:1.5px solid rgba(0,0,0,.06); box-shadow:0 4px 18px rgba(0,0,0,.06);
  display:flex; flex-direction:column; gap:14px; transition:all .28s; position:relative; overflow:hidden;
}
.prod-card::before {
  content:''; position:absolute; top:0; left:0; right:0; height:3px;
  background:linear-gradient(90deg,var(--orange),var(--orange-l));
  transform:scaleX(0); transform-origin:left; transition:transform .28s;
}
.prod-card:hover { transform:translateY(-4px); box-shadow:0 12px 40px rgba(0,0,0,.1); border-color:rgba(255,124,26,.25); }
.prod-card:hover::before { transform:scaleX(1); }
.prod-icon {
  width:52px; height:52px; border-radius:14px;
  background:rgba(255,124,26,.1); display:flex; align-items:center; justify-content:center;
}
.prod-icon svg { width:26px; height:26px; }
.prod-tag { font-size:10px; font-weight:700; color:var(--orange); letter-spacing:.1em; text-transform:uppercase; }
.prod-name { font-size:20px; font-weight:800; color:#111; line-height:1.15; }
.prod-desc { font-size:14px; color:#666; line-height:1.65; flex:1; }
.prod-link {
  display:inline-flex; align-items:center; gap:6px;
  font-size:13px; font-weight:700; color:var(--orange); margin-top:4px;
  transition:gap .2s;
}
.prod-link:hover { gap:10px; }
.prod-link svg { width:14px; height:14px; }

/* ─── SOBRE ─── */
#sobre { background:var(--dark2); padding:var(--py) var(--px); position:relative; overflow:hidden; }
.sobre-layout { display:flex; flex-direction:column; gap:40px; }
.sobre-text .h2 { color:#fff; }
.sobre-text .sub { color:rgba(255,255,255,.55); max-width:560px; }
.sobre-quote {
  border-left:3px solid var(--orange); padding-left:20px;
  font-size:clamp(16px,2.2vw,20px); font-weight:700; color:#fff; line-height:1.55;
  margin-top:28px;
}
.sobre-pillars { display:flex; flex-direction:column; gap:14px; margin-top:28px; }
.pillar {
  display:flex; align-items:flex-start; gap:14px;
  padding:16px 18px; background:rgba(255,255,255,.04);
  border:1px solid rgba(255,255,255,.07); border-radius:14px;
  transition:all .22s;
}
.pillar:hover { border-color:rgba(255,124,26,.3); background:rgba(255,124,26,.04); }
.pillar-icon {
  width:38px; height:38px; border-radius:10px;
  background:rgba(255,124,26,.12); display:flex; align-items:center; justify-content:center; flex-shrink:0;
}
.pillar-icon svg { width:19px; height:19px; }
.pillar-title { font-size:14px; font-weight:700; color:#fff; margin-bottom:3px; }
.pillar-desc { font-size:13px; color:rgba(255,255,255,.5); line-height:1.55; }

/* sobre numbers */
.sobre-numbers { display:grid; grid-template-columns:1fr 1fr; gap:16px; }
.snumber {
  background:rgba(255,255,255,.04); border:1px solid rgba(255,255,255,.08);
  border-radius:16px; padding:22px 18px; text-align:center;
}
.snumber-val { font-size:clamp(32px,6vw,48px); font-weight:900; color:var(--orange); letter-spacing:-.03em; line-height:1; display:block; }
.snumber-lbl { font-size:12px; color:rgba(255,255,255,.42); margin-top:6px; line-height:1.4; }

/* ─── CLIENT LOGOS ─── */
.cs-strip { background:var(--dark3); padding:44px var(--px) 40px; overflow:hidden; }
.cs-label { text-align:center; font-size:10px; font-weight:700; letter-spacing:.2em; text-transform:uppercase; color:rgba(255,255,255,.28); margin-bottom:30px; }
.cs-wrap { overflow:hidden; mask-image:linear-gradient(to right,transparent,#000 14%,#000 86%,transparent); -webkit-mask-image:linear-gradient(to right,transparent,#000 14%,#000 86%,transparent); }
.cs-track { display:flex; gap:48px; width:max-content; animation:csMarquee 22s linear infinite; }
.cs-track:hover { animation-play-state:paused; }
@keyframes csMarquee { from{transform:translateX(0)} to{transform:translateX(-50%)} }
.cs-logo { display:flex; align-items:center; justify-content:center; flex-shrink:0; height:52px; opacity:.45; transition:opacity .3s ease; cursor:default; }
.cs-logo:hover { opacity:.75; }
.cs-logo img { height:40px; width:auto; max-width:130px; object-fit:contain; filter:brightness(0) invert(1); }

/* ─── PROX CTA (orange banner) ─── */
#cta-banner { padding:var(--py) var(--px); background:var(--dark); }
.cta-inner {
  background:linear-gradient(130deg,var(--orange) 0%,#ff9a30 55%,var(--orange-d) 100%);
  border-radius:24px; padding:52px 36px;
  display:flex; flex-direction:column; gap:28px; align-items:flex-start;
  position:relative; overflow:hidden;
}
.cta-inner::before {
  content:''; position:absolute; top:-40%; right:-10%; width:400px; height:400px;
  background:rgba(255,255,255,.07); border-radius:50%; pointer-events:none;
}
.cta-inner::after {
  content:''; position:absolute; bottom:-60%; left:-5%; width:300px; height:300px;
  background:rgba(255,255,255,.04); border-radius:50%; pointer-events:none;
}
.cta-eyebrow { font-size:11px; font-weight:700; letter-spacing:.15em; color:rgba(255,255,255,.7); text-transform:uppercase; }
.cta-txt { font-size:clamp(22px,4vw,36px); font-weight:900; color:#fff; line-height:1.15; max-width:560px; position:relative; z-index:1; }
.cta-btns { display:flex; gap:12px; flex-wrap:wrap; position:relative; z-index:1; }
.btn-white {
  display:inline-flex; align-items:center; gap:8px;
  padding:14px 28px; background:#fff; color:var(--orange);
  border:none; border-radius:10px; font-size:15px; font-weight:800;
  cursor:pointer; font-family:inherit;
  box-shadow:0 4px 18px rgba(0,0,0,.15); transition:all .22s;
}
.btn-white:hover { transform:translateY(-2px); box-shadow:0 8px 28px rgba(0,0,0,.2); }
.btn-white-ghost {
  display:inline-flex; align-items:center; gap:8px;
  padding:14px 28px; background:rgba(255,255,255,.15); color:#fff;
  border:1.5px solid rgba(255,255,255,.4); border-radius:10px;
  font-size:15px; font-weight:700; cursor:pointer; font-family:inherit; transition:all .22s;
}
.btn-white-ghost:hover { background:rgba(255,255,255,.25); }

/* ─── FOOTER ─── */
footer { background:var(--dark); border-top:1px solid rgba(255,255,255,.06); padding:56px var(--px) 32px; }
.footer-grid { display:flex; flex-direction:column; gap:40px; margin-bottom:40px; }
.footer-brand > p { font-size:13px; color:rgba(255,255,255,.35); line-height:1.7; margin-top:14px; max-width:240px; }
.footer-socials { display:flex; gap:10px; margin-top:16px; }
.soc {
