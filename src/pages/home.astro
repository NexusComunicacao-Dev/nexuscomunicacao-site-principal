}
.soc:hover { background:rgba(255,124,26,.15); border-color:var(--orange); color:var(--orange); }
.footer-cols { display:grid; grid-template-columns:1fr 1fr; gap:32px 20px; }
.fc h4 { font-size:11px; font-weight:700; color:rgba(255,255,255,.35); letter-spacing:.1em; text-transform:uppercase; margin-bottom:14px; }
