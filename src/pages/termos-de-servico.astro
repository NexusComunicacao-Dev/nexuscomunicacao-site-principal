body { font-family:'Inter',sans-serif; background:#fff; color:#111; line-height:1.7; }
img, svg { display:block; max-width:100%; }
a { color:#111; }
.topbar { border-bottom:1px solid #e5e5e5; }
.topbar-inner { max-width:860px; margin:0 auto; padding:18px 24px; display:flex; align-items:center; justify-content:space-between; }
.topbar a.back { font-size:14px; font-weight:600; text-decoration:none; }
.topbar a.back:hover { text-decoration:underline; }
.wrap { max-width:860px; margin:0 auto; padding:48px 24px 80px; }
