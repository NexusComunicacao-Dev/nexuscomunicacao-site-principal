---
import Base from '../layouts/Base.astro';
---
<Base
  title="NEXUS | Obrigado pelo contato!"
  description="Recebemos a sua solicitação. Um consultor da NEXUS Comunicação entra em contato em até 2 horas úteis com uma proposta personalizada."
>

<!-- Event snippet for LEAD FORM conversion page -->
<script is:inline slot="head">
  gtag('event', 'conversion', {
      'send_to': 'AW-328024362/DgUjCNm725McEKqCtZwB',
      'value': 1.0,
      'currency': 'BRL'
  });
</script>

<style is:global>

:root {
  --orange: #ff7c1a;
  --orange-l: #ff9a4a;
  --dark: #4a4a4a;
  --dark2: #3d3d3d;
}

*, *::before, *::after { margin:0; padding:0; box-sizing:border-box; }
html { height:100%; }
body {
  font-family:'Inter',sans-serif;
  background:var(--dark);
  color:#fff;
  min-height:100vh;
  display:flex;
  flex-direction:column;
  align-items:center;
  justify-content:center;
  overflow:hidden;
  position:relative;
}

::-webkit-scrollbar { width:4px; }
::-webkit-scrollbar-thumb { background:var(--orange); border-radius:2px; }
a { text-decoration:none; }

/* ── MESH BG ── */
#mesh { position:fixed; inset:0; z-index:0; pointer-events:none; }

/* ── GLOW ── */
.glow {
  position:fixed; inset:0; z-index:0; pointer-events:none;
  background:
    radial-gradient(ellipse 70% 60% at 50% 40%, rgba(255,124,26,.09) 0%, transparent 65%),
    radial-gradient(ellipse 40% 30% at 20% 80%, rgba(255,124,26,.05) 0%, transparent 55%);
}

/* ── GRID BG ── */
.grid-bg {
  position:fixed; inset:0; z-index:0; pointer-events:none;
  background-image:
    linear-gradient(rgba(255,124,26,.04) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255,124,26,.04) 1px, transparent 1px);
  background-size:56px 56px;
  mask-image:radial-gradient(ellipse at 50% 40%, black 15%, transparent 72%);
}

/* ── CARD ── */
.card {
  position:relative; z-index:10;
  display:flex; flex-direction:column; align-items:center;
  text-align:center;
  padding:56px 40px;
  max-width:560px;
  width:calc(100% - 48px);
  background:rgba(61,61,61,.72);
  border:1px solid rgba(255,124,26,.18);
  border-radius:28px;
  backdrop-filter:blur(24px);
  box-shadow:0 40px 100px rgba(0,0,0,.55), 0 0 0 1px rgba(255,255,255,.05) inset;
  animation:cardIn .7s cubic-bezier(.22,1,.36,1) both;
}
@keyframes cardIn {
  from { opacity:0; transform:translateY(32px) scale(.97); }
  to   { opacity:1; transform:none; }
}

/* ── CHECK ICON ── */
.check-wrap {
  width:80px; height:80px; border-radius:24px;
  background:rgba(255,124,26,.12);
  border:2px solid rgba(255,124,26,.3);
  display:flex; align-items:center; justify-content:center;
  margin-bottom:28px;
  animation:popIn .6s cubic-bezier(.34,1.56,.64,1) .2s both;
}
@keyframes popIn {
  from { opacity:0; transform:scale(.5); }
  to   { opacity:1; transform:scale(1); }
}

/* ── RING ANIMATION ── */
.check-ring {
  position:absolute;
  width:80px; height:80px; border-radius:24px;
  border:2px solid var(--orange);
  animation:ringPulse 2.4s ease-in-out .5s infinite;
}

/* respeita quem pediu menos movimento no sistema: as animações infinitas param
   no estado inicial. !important garante a vitória independente da ordem de bundle. */
@media (prefers-reduced-motion: reduce) {
  .check-ring { animation:none !important; }
}
.check-wrap-outer { position:relative; margin-bottom:28px; display:flex; align-items:center; justify-content:center; }
@keyframes ringPulse {
  0%   { opacity:.6; transform:scale(1); }
  60%  { opacity:0;  transform:scale(1.55); }
  100% { opacity:0;  transform:scale(1.55); }
}

.card-title {
  font-size:clamp(28px, 5vw, 42px);
  font-weight:900;
  letter-spacing:-.03em;
  line-height:1.1;
  margin-bottom:14px;
}
.card-title .accent { color:var(--orange); }

.card-desc {
  font-size:clamp(14px, 1.6vw, 16px);
  color:rgba(255,255,255,.5);
  line-height:1.8;
  max-width:420px;
  margin-bottom:36px;
}

/* ── DIVIDER ── */
.divider {
  width:48px; height:2px;
  background:linear-gradient(90deg, transparent, var(--orange), transparent);
  border-radius:2px;
  margin:0 auto 32px;
}

/* ── INFO CHIPS ── */
.chips { display:flex; flex-direction:column; gap:12px; width:100%; margin-bottom:36px; }
.chip {
  display:flex; align-items:center; gap:12px;
  padding:14px 18px;
  background:rgba(255,255,255,.04);
  border:1px solid rgba(255,255,255,.08);
  border-radius:14px;
  font-size:13px; color:rgba(255,255,255,.65);
  text-align:left;
}
.chip-icon {
  width:36px; height:36px; border-radius:10px; flex-shrink:0;
  background:rgba(255,124,26,.12);
  display:flex; align-items:center; justify-content:center;
}

/* ── CONTACT ── */
.contact-row {
  display:flex; flex-wrap:wrap; gap:10px; justify-content:center;
  font-size:13px; color:rgba(255,255,255,.38);
}
.contact-row a { color:rgba(255,255,255,.38); transition:color .2s; }
.contact-row a:hover { color:var(--orange); }
.contact-sep { opacity:.3; }

/* ── FOOTER LOGO ── */
.footer-logo {
  position:fixed; bottom:24px; left:50%; transform:translateX(-50%);
  z-index:10; opacity:.35;
  transition:opacity .2s;
}
.footer-logo:hover { opacity:.7; }
</style>

<canvas id="mesh"></canvas>
<div class="glow"></div>
<div class="grid-bg"></div>

<div class="card">

  <div class="check-wrap-outer">
    <div class="check-ring"></div>
    <div class="check-wrap">
      <svg width="36" height="36" viewBox="0 0 24 24" fill="none"
           stroke="var(--orange)" stroke-width="2.2"
           stroke-linecap="round" stroke-linejoin="round">
        <polyline points="20 6 9 17 4 12"/>
      </svg>
    </div>
  </div>

  <h1 class="card-title">Obrigado pelo <span class="accent">contato!</span></h1>
  <p class="card-desc">Recebemos sua solicitação com sucesso. Nossa equipe entrará em contato em breve com uma proposta personalizada.</p>

  <div class="divider"></div>

  <div class="chips">
    <div class="chip">
      <div class="chip-icon">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none"
             stroke="var(--orange)" stroke-width="1.8"
             stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"/>
          <polyline points="12 6 12 12 16 14"/>
        </svg>
      </div>
      <span>Nossa equipe responde em até <strong style="color:#fff;">2 horas úteis</strong></span>
    </div>
    <div class="chip">
      <div class="chip-icon">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none"
             stroke="var(--orange)" stroke-width="1.8"
             stroke-linecap="round" stroke-linejoin="round">
          <path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07A19.5 19.5 0 013.07 9.81 19.79 19.79 0 01.01 1.18 2 2 0 012 0h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L6.09 7.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"/>
        </svg>
      </div>
      <span>Ou entre em contato agora: <a href="tel:+551135694630" style="color:var(--orange);font-weight:600;">(11) 3569-4630</a></span>
    </div>
    <div class="chip">
      <div class="chip-icon">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none"
             stroke="var(--orange)" stroke-width="1.8"
             stroke-linecap="round" stroke-linejoin="round">
          <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
          <polyline points="22,6 12,13 2,6"/>
        </svg>
      </div>
      <span><a href="mailto:atendimento@nexuscomunicacao.com" style="color:var(--orange);font-weight:600;">atendimento@nexuscomunicacao.com</a></span>
    </div>
  </div>

  <div class="contact-row">
    <span>© 2026 NEXUS Comunicação</span>
    <span class="contact-sep">·</span>
    <a href="/">SMS Marketing</a>
    <span class="contact-sep">·</span>
    <a href="/rcs">RCS</a>
    <span class="contact-sep">·</span>
    <a href="/whatsapp">WhatsApp</a>
  </div>
</div>

<a href="/" class="footer-logo" aria-label="Início">
  <img src="/logo-white.svg" alt="NEXUS Comunicação" height="22" style="display:block;">
</a>

<script is:inline>
/* ── MESH WAVE ── */
(function(){
  const canvas=document.getElementById('mesh'), ctx=canvas.getContext('2d');
  const COLS=20, ROWS=11, AMP=14, SPD=0.009;
  let W, H, t=0;
  const reduce=window.matchMedia('(prefers-reduced-motion: reduce)');
  /* grade alocada uma única vez e reaproveitada a cada frame */
  const pts=[];
  for(let i=0;i<(ROWS+1)*(COLS+1);i++) pts.push({x:0,y:0});
  function pt(r,c){ return pts[r*(COLS+1)+c]; }
  function resize(){ W=canvas.width=innerWidth; H=canvas.height=innerHeight; if(reduce.matches) render(); }
  window.addEventListener('resize', resize);
  function render(){
    ctx.clearRect(0,0,W,H);
    const cw=W/COLS, ch=H/ROWS;
    for(let r=0;r<=ROWS;r++) for(let c=0;c<=COLS;c++){
      const p=pts[r*(COLS+1)+c];
      p.x=c*cw;
      p.y=r*ch + Math.sin(c*.38+r*.55+t)*AMP + Math.sin(c*.22-r*.3+t*.7)*AMP*.5;
    }
    /* todos os segmentos em um único path: 1 stroke() por frame */
    ctx.strokeStyle='rgba(255,124,26,0.05)'; ctx.lineWidth=1;
    ctx.beginPath();
    for(let r=0;r<ROWS;r++) for(let c=0;c<COLS;c++){
      const p=pt(r,c), pr=pt(r,c+1), pb=pt(r+1,c), pd=pt(r+1,c+1);
      ctx.moveTo(p.x,p.y); ctx.lineTo(pr.x,pr.y);
      ctx.moveTo(p.x,p.y); ctx.lineTo(pb.x,pb.y);
      if(c===COLS-1){ ctx.moveTo(pr.x,pr.y); ctx.lineTo(pd.x,pd.y); }
      if(r===ROWS-1){ ctx.moveTo(pb.x,pb.y); ctx.lineTo(pd.x,pd.y); }
    }
    ctx.stroke();
  }
  function draw(){
    if(!document.hidden){ render(); t+=SPD; }
    requestAnimationFrame(draw);
  }
  resize();
  if(reduce.matches) render(); else requestAnimationFrame(draw);
})();
</script>
</Base>
