---
// Footer único do site (mesma estrutura da index). Usado em TODAS as páginas
// de canal. Coluna "Soluções" lista todos os canais. Antes cada página tinha
// seu próprio footer divergente.
import Logo from './Logo.astro';
---
<footer>
  <div class="footer-grid">
    <div class="footer-brand">
      <Logo height="30" />
      <p>A infraestrutura de comunicação digital para marcas que querem crescer com inteligência e escala.</p>
      <div class="footer-socials">
        <a href="https://www.linkedin.com/company/nexus-comunica%C3%A7%C3%A3o/?originalSubdomain=br" target="_blank" rel="noopener" class="soc" aria-label="LinkedIn">in</a>
        <a href="https://www.instagram.com/nexuscomunicacao/" target="_blank" rel="noopener" class="soc" aria-label="Instagram">ig</a>
      </div>
    </div>
    <div class="footer-cols">
      <div class="fc">
        <h3>Institucional</h3>
        <a href="/sobre-nos">Sobre nós</a>
      </div>
      <div class="fc">
        <h3>Soluções</h3>
        <a href="/">SMS Marketing</a>
        <a href="/rcs">RCS Business Messaging</a>
        <a href="/whatsapp">WhatsApp Marketing</a>
        <a href="/push">Push Ads</a>
      </div>
      <div class="fc">
        <h3>Agentes</h3>
        <a href="/agents/convoca">Convoca</a>
        <a href="/agents/mandato-digital">Mandato Digital</a>
        <a href="/agents/porta-voz">Porta-Voz</a>
        <a href="/agents/voz-ativa">Voz Ativa</a>
      </div>
      <div class="fc">
        <h3>Contato</h3>
        <div class="fc-contact">(11) 94378-6960</div>
        <div class="fc-contact">atendimento@nexuscomunicacao.com</div>
        <div class="fc-contact">R Orfanato 760, Loja 44<br>Vila Prudente · São Paulo – SP · 03131-010</div>
        <div class="fc-contact">COMUNIKA SERVIÇOS EM COMUNICAÇÃO LTDA · CNPJ 51.767.476/0001-93</div>
      </div>
    </div>
  </div>
  <div class="footer-bottom">
    <p>© 2026 NEXUS Comunicação. Todos os direitos reservados.</p>
    <p><a href="/politica-de-privacidade" style="color:inherit;">Política de Privacidade</a> · <a href="/termos-de-servico" style="color:inherit;">Termos de Uso</a></p>
  </div>
</footer>
<style is:global>
  /* 4 colunas no footer (Institucional/Soluções/Agentes/Contato), sobrescreve o repeat(3) das páginas.
     A especificidade extra (.footer-grid .footer-cols) mantém a mesma vitória na cascata
     independentemente da ordem em que o CSS empacotado é emitido. */
  .footer-grid .footer-cols { grid-template-columns: 1fr 1fr; }
  @media (min-width: 1024px) { .footer-grid .footer-cols { grid-template-columns: repeat(4, 1fr); } }
</style>
